<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.parkinsonsdiseasedetection">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ParkinsonDiseaseDetection">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Explore Activity -->
        <activity
            android:name=".ExploreActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity" />   <!-- Back to MainActivity -->

        <!-- Know Parkinson Activity -->
        <activity
            android:name=".KnowParkinsonActivity"
            android:exported="true"
            android:parentActivityName=".ExploreActivity" />   <!-- Back to ExploreActivity -->

        <!-- Detect Parkinson Activity -->
        <activity
            android:name=".DetectParkinsonActivity"
            android:exported="true"
            android:parentActivityName=".ExploreActivity" />   <!-- Back to ExploreActivity -->

    </application>
</manifest>
